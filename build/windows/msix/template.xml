<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="quire"
        Arguments=""
        InstallLocation="C:\Program Files\BenNotes\Quire">
    </Installer>
    <PackageInformation
        PackageName="Quire"
        PackageDisplayName="Quire"
        PublisherName="CN=BenNotes"
        PublisherDisplayName="BenNotes"
        Version="0.1.0.0"
        PackageDescription="A local-first Markdown notebook">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ben-notes.quire"
                Description="A local-first Markdown notebook"
                DisplayName="Quire"
                ExecutableName="quire"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Quire</DisplayName>
            <PublisherDisplayName>BenNotes</PublisherDisplayName>
            <Description>A local-first Markdown notebook</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="quire.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
